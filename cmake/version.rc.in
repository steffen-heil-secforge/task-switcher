// Auto-configured by CMake from cmake/version.rc.in — embeds Win32 VERSIONINFO so the
// binaries carry publisher/product metadata (an unsigned binary with NO metadata reads as
// far more suspicious to AV heuristics + reputation systems).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       @TSW_FILETYPE@
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "secforge GmbH"
            VALUE "FileDescription",  "@TSW_FILEDESC@"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "@TSW_INTERNAL@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Steffen Heil, secforge GmbH. MIT-licensed."
            VALUE "OriginalFilename", "@TSW_ORIGNAME@"
            VALUE "ProductName",      "Task Switcher"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
